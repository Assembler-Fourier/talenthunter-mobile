    "@supabase/supabase-js": "^2.116.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "pg": "^8.23.0",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run dev:hosted",
    "android": "bash scripts/native-env.sh npx expo run:android",
    "ios": "bash scripts/native-env.sh npx expo run:ios",
    "web": "node scripts/with-backend.mjs hosted npx expo start --web --localhost --port 8081",
    "typecheck": "tsc --noEmit",
    "android:local": "bash scripts/native-env.sh npx expo run:android",
    "ios:local": "bash scripts/native-env.sh npx expo run:ios",
    "test:security": "node tests/live-security.mjs",
    "build:android": "bash scripts/build-android.sh",
    "build:ios:simulator": "bash scripts/build-ios-simulator.sh",
    "dev:local": "node scripts/with-backend.mjs local npx expo start --localhost --port 8082",
    "dev:hosted": "node scripts/with-backend.mjs hosted npx expo start --localhost --port 8081",
    "android:dev": "bash scripts/android-local-dev.sh",
    "ios:dev": "node scripts/with-backend.mjs local bash scripts/native-env.sh npx expo run:ios --port 8082",
    "local:start": "node scripts/start-local.mjs",
    "local:stop": "node scripts/stop-local.mjs",
    "local:seed": "node scripts/test-local.mjs --keep",
    "test:local": "node scripts/test-local.mjs",
    "test:config": "node --test tests/backend-config.test.mjs",
    "format": "prettier --write src scripts tests README.md package.json app.json supabase/README.md",
    "format:check": "prettier --check src scripts tests README.md package.json app.json supabase/README.md",
    "test:email:local": "node tests/local-email.mjs",
    "test:audit:local": "node tests/deep-audit.mjs",
    "test:unit": "node --test tests/backend-config.test.mjs tests/session-storage.test.mjs tests/email-auth.test.mjs tests/applicant-page.test.mjs tests/resume-upload.test.mjs",
    "test:email:hosted": "node tests/live-email-auth.mjs",
    "check:hosted": "node scripts/check-hosted.mjs",
    "dev:phone": "node scripts/with-backend.mjs hosted npx expo start --lan --port 8081",
    "build:iphone": "node scripts/build-ios-device.mjs",
    "install:iphone": "node scripts/install-ios-device.mjs",
    "test:postman": "node scripts/test-postman.mjs",
    "test:boundaries:local": "node tests/local-boundaries.mjs"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
